# Copy to .env (git-ignored) and fill in. Only the key for the chosen provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM that decides which tools to call: openai (default) or anthropic.
VOICE_PROVIDER=openai

# Model (default per provider: gpt-5.5 for openai, claude-opus-5 for anthropic) and
# reasoning effort. Lower effort answers faster; raise it if tool choices go wrong.
# For quicker replies with OpenAI, try VOICE_MODEL=gpt-5.4-mini.
VOICE_MODEL=
VOICE_EFFORT=low

# Push-to-talk key: right_command (on US and Japanese keyboards), right_option, left_option,
# right_control, eisu (英数), kana (かな), fn, f13, f14, f15. The key also reaches the front
# app: eisu and kana switch the input source, fn may open the emoji or dictation panel.
VOICE_PTT_KEY=right_command

# Local Whisper model (faster-whisper): tiny.en, base.en, small.en, medium.en, or a
# multilingual size (small, medium, large-v3) for languages other than English.
VOICE_STT_MODEL=small.en

# Words speech recognition should always expect, comma-separated: project names and
# jargon it would otherwise mishear. Names from listings are also learned automatically
# and remembered in ~/.cache/local-voice-ptt/names.json.
VOICE_VOCABULARY=

# ./voice_ptt.py --prime scans the apps to learn every project and session name.
# Limit it to some apps, and/or run it at every startup (it switches app views, then back).
VOICE_PRIME_APPS=
VOICE_PRIME_ON_START=

# macOS voice and words per minute for `say` (empty = system default). List voices: say -v '?'
VOICE_SAY_VOICE=
VOICE_SAY_RATE=

# Longest recording; stops even if the key still reads as held.
VOICE_MAX_RECORD_SECONDS=60

# Conversation turns kept for context.
VOICE_MAX_TURNS=12

# MCP server path (default: ../multi-agent-mcp/agent_mcp.py).
# AGENT_MCP=
