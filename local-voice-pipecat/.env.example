# Copy to .env (git-ignored) and fill in. Only the key for the chosen provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM that decides which tools to call: openai (default, Responses API over WebSocket)
# or anthropic.
VOICE_PROVIDER=openai

# Model (default per provider: gpt-5.5 for openai, claude-opus-5 for anthropic) and
# reasoning effort. Lower effort answers faster; raise it if tool choices go wrong.
VOICE_MODEL=
VOICE_EFFORT=low

# Local Whisper model (faster-whisper): tiny.en, base.en, small.en, medium.en, or a
# multilingual size (small, medium, large-v3). small.en is shared with local-voice-ptt.
VOICE_STT_MODEL=small.en

# Words speech recognition should always expect, comma-separated. Names from listings are
# also learned automatically and shared with local-voice-ptt in
# ~/.cache/local-voice-ptt/names.json (run ../local-voice-ptt/voice_ptt.py --prime to scan).
VOICE_VOCABULARY=

# Kokoro voice (af_heart, af_bella, am_michael, bf_emma, bm_george, ...) and speed (0.5-2.0).
VOICE_KOKORO_VOICE=af_heart
VOICE_KOKORO_SPEED=

# Port for the web page and WebRTC signaling (the server listens on 127.0.0.1).
VOICE_PORT=7860

# 1 shows Pipecat's debug log (same as --debug).
VOICE_DEBUG=

# MCP server path (default: ../multi-agent-mcp/agent_mcp.py).
# AGENT_MCP=
