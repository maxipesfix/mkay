# Copy to .env (git-ignored) and fill in. Only the key for the chosen provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM that decides which tools to call: openai (default, Responses API over WebSocket),
# anthropic, or local (an OpenAI-compatible server on this Mac: LM Studio on port 1234,
# then Ollama on 11434, or VOICE_LOCAL_LLM_URL). The page's Model menu can switch per session.
VOICE_PROVIDER=openai
VOICE_LOCAL_LLM_URL=
VOICE_LOCAL_MODEL=

# Model (default per provider: gpt-5.5 for openai, claude-opus-5 for anthropic) and
# reasoning effort. Lower effort answers faster; raise it if tool choices go wrong.
VOICE_MODEL=
VOICE_EFFORT=low

# Speech services. Cloud APIs are used when their key is set, local models otherwise;
# VOICE_STT (deepgram or whisper) and VOICE_TTS (cartesia, fish or kokoro) choose explicitly.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
FISH_API_KEY=
VOICE_STT=
VOICE_TTS=

# Speech-to-text model: Deepgram (default nova-3-general) or local Whisper (default
# small.en, shared with local-voice-ptt; also tiny.en ... medium.en, small, medium, large-v3).
VOICE_STT_MODEL=
# Deepgram language: en (default), a language code such as ja, or multi for several.
VOICE_STT_LANGUAGE=

# Cartesia voice: daniel (default), skylar, jacqueline, gemma, archie, or a voice ID from
# cartesia.ai; and model (default sonic-3.6).
VOICE_CARTESIA_VOICE=
VOICE_CARTESIA_MODEL=

# Fish Audio voice: sarah (default), hannah, ethan, adrian, or a model ID from fish.audio;
# and model (default s2.1-pro).
VOICE_FISH_VOICE=
VOICE_FISH_MODEL=

# Words speech recognition should always expect, comma-separated. Names from listings are
# also learned automatically and shared with local-voice-ptt in
# ~/.cache/local-voice-ptt/names.json (run ../local-voice-ptt/voice_ptt.py --prime to scan).
VOICE_VOCABULARY=

# Local Kokoro voice: heart (default), bella, michael, emma, george, or any Kokoro voice such
# as af_sky; and speed (0.5-2.0).
VOICE_KOKORO_VOICE=heart
VOICE_KOKORO_SPEED=

# Port for the web page and WebRTC signaling (the server listens on 127.0.0.1).
VOICE_PORT=7860

# 1 shows Pipecat's debug log (same as --debug).
VOICE_DEBUG=

# 0 keeps conversation content (what was said, tool arguments and results) out of the log;
# only lengths are logged. For servers that must not store conversations.
VOICE_LOG_CONTENT=

# MCP server path (default: ../multi-agent-mcp/agent_mcp.py).
# AGENT_MCP=
